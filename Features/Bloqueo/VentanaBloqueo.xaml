<Window x:Class="FocusPomodoro.Features.Bloqueo.VentanaBloqueo"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Fuera de Horario"
        WindowState="Maximized"
        WindowStyle="None"
        Topmost="True"
        Background="#0d0d16"
        ResizeMode="NoResize">

    <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#0d0d16" Offset="0"/>
                <GradientStop Color="#161625" Offset="0.5"/>
                <GradientStop Color="#0d0d16" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>

        <!-- Decoración de fondo -->
        <Ellipse Width="500" Height="500" Fill="#00d9ff" Opacity="0.02" 
                 Margin="-250,-250,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"/>
        <Ellipse Width="400" Height="400" Fill="#4ade80" Opacity="0.02" 
                 Margin="0,0,-200,-200" HorizontalAlignment="Right" VerticalAlignment="Bottom"/>

        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
            <!-- Icono -->
            <TextBlock Text="🌙" FontSize="72" HorizontalAlignment="Center" Margin="0,0,0,20"/>

            <!-- Título -->
            <TextBlock Text="Fuera de horario de trabajo"
                       FontSize="42"
                       FontWeight="ExtraBold"
                       Foreground="White"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,15">
                <TextBlock.Effect>
                    <DropShadowEffect BlurRadius="20" Color="#00d9ff" Opacity="0.3" ShadowDepth="0"/>
                </TextBlock.Effect>
            </TextBlock>

            <!-- Subtítulo con hora -->
            <TextBlock x:Name="SubtitleText"
                       Text="Vuelve a las 08:00"
                       FontSize="24"
                       Foreground="#00d9ff"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,40"/>

            <!-- Mensaje motivacional -->
            <TextBlock Text="&quot;El descanso es parte del éxito. Cuida tu energía.&quot;"
                       FontSize="16"
                       FontStyle="Italic"
                       Foreground="#444"
                       HorizontalAlignment="Center"/>
        </StackPanel>
    </Grid>
</Window>
